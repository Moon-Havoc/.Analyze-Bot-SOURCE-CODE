# Discord application credentials
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register commands only in this test guild. Leave blank to register globally.
GUILD_ID=

# Optional audit-log channel used for blacklist, ticket, watchlist, case,
# and lookup actions in each guild.
AUDIT_LOG_CHANNEL_ID=

# Ticket system — category channel where new ticket channels are created.
# Can also be set per-guild via /ticket panel category:<channel>.
TICKET_CATEGORY_ID=

# Ticket system — channel where the support panel embed is posted.
# Can also be set per-guild via /ticket panel channel:<channel>.
SUPPORT_CHANNEL_ID=

# Ticket system — optional role that can claim and manage tickets.
SUPPORT_ROLE_ID=

# Moderation commands — role ID for management team access to /mod commands.
MANAGEMENT_ROLE_ID=1494515574338879558

# Server lockdown — role ID for executive access to /lockdown commands.
EXECUTIVE_ROLE_ID=1494510299976568842

# Server lockdown — authentication key required to lift lockdown and for other executive commands.
EXECUTIVE_AUTH_KEY=

# AI Moderation — Google Perspective API key for AI-powered content moderation.
# Get your API key from: https://console.cloud.google.com/apis/api/commentanalyzer.googleapis.com
PERSPECTIVE_API_KEY=AIzaSyD0BoJhX9q5aMqqztMlwNzchFswPjjxIYg

# Web Dashboard Configuration
WEB_PORT=3000
WEB_URL=http://localhost:5173
SESSION_SECRET=your-session-secret-change-this
NODE_ENV=development
